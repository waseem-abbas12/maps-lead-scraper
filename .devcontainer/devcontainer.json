{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "scraper.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "sudo apt update && sudo xargs -a packages.txt apt install -y && pip3 install -r requirements.txt && python3 -m playwright install chromium && echo '✅ Requirements & Chromium installed'",
  "postAttachCommand": {
    "server": "python3 server.py"
  },
  "portsAttributes": {
    "8000": {
      "label": "Maps Lead Scraper Portal",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "forwardPorts": [
    8000
  ]
}